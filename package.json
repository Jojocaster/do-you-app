    "jest": "~29.7.0",
    "jest-coverage-badges": "1.1.2",
    "jest-expo": "~52.0.6",
    "jest-fetch-mock": "3.0.3",
    "prettier": "2.6.2",
    "react-test-renderer": "18.1.0",
